---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Menú digital interactivo' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Preconnect + fuente: Fraunces (display + body, variable, con italics) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;0,9..144,800;1,9..144,500;1,9..144,600&display=swap"
      rel="stylesheet"
    />

    <meta name="theme-color" content="#2A50BC" />
  </head>
  <body class="font-body antialiased min-h-screen">
    <slot />
  </body>
</html>