---
interface Props {
  whatsapp?: string; // número en formato internacional sin '+', ej. '5215512345678'
  instagram?: string; // usuario sin '@'
}

const { whatsapp = '5215500000000', instagram = 'tuLocal' } = Astro.props;
---

<footer class="px-6 py-10 text-center bg-paper-dark border-t border-line">
  <div class="flex items-center justify-center gap-3 mb-6">
    <a
      href={`https://wa.me/${whatsapp}`}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-2 rounded-full bg-accent text-paper px-5 py-2.5 text-sm font-medium hover:opacity-90 transition-opacity"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.79.47 3.44 1.35 4.87L2 22l5.36-1.42a9.9 9.9 0 0 0 4.68 1.19h.01c5.46 0 9.9-4.45 9.9-9.91C21.95 6.45 17.5 2 12.04 2zm0 18.06a8.16 8.16 0 0 1-4.16-1.14l-.3-.18-3.09.81.83-3.02-.2-.31a8.15 8.15 0 1 1 6.92 3.84z"/>
      </svg>
      Pedir por WhatsApp
    </a>
    <a
      href={`https://instagram.com/${instagram}`}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-2 rounded-full border border-line px-5 py-2.5 text-sm font-medium text-ink hover:bg-paper transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="3.5" />
        <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none" />
      </svg>
      @{instagram}
    </a>
  </div>

  <p class="text-xs text-muted max-w-sm mx-auto leading-relaxed">
    Precios incluyen IVA. Consulta a tu mesero sobre alérgenos e ingredientes
    antes de ordenar. Menú sujeto a disponibilidad y cambios sin previo aviso.
  </p>
</footer>
