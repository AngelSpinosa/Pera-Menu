---
interface Props {
  categorias: { categoria: string; slug: string }[];
}

const { categorias } = Astro.props;
---

<nav
  id="category-nav"
  class="sticky top-0 z-30 bg-paper/95 backdrop-blur-sm border-b border-line"
  aria-label="Categorías del menú"
>
  <div class="no-scrollbar flex gap-2 overflow-x-auto px-4 py-3 snap-x snap-mandatory justify-center w-full">
    {categorias.map(({ categoria, slug }, i) => (
      <a
        href={`#cat-${slug}`}
        data-slug={slug}
        class:list={[
          'nav-tab snap-start shrink-0 whitespace-nowrap rounded-full px-4 py-1.5 text-base font-medium border transition-colors',
          i === 0
            ? 'is-active bg-accent text-paper border-accent'
            : 'bg-transparent text-ink border-line',
        ]}
      >
        {categoria}
      </a>
    ))}
  </div>
</nav>

<script>
  // JS vanilla hiperligero: resalta la pestaña activa según la categoría
  // visible en pantalla, y hace scroll de la pestaña dentro de la nav.
  const tabs = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav-tab'));
  const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-category-section]'));

  function setActive(slug: string) {
    tabs.forEach((tab) => {
      const active = tab.dataset.slug === slug;
      tab.classList.toggle('is-active', active);
      tab.classList.toggle('bg-accent', active);
      tab.classList.toggle('text-paper', active);
      tab.classList.toggle('border-accent', active);
      tab.classList.toggle('bg-transparent', !active);
      tab.classList.toggle('text-ink', !active);
      tab.classList.toggle('border-line', !active);
      if (active) {
        tab.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
      }
    });
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      if (tab.dataset.slug) setActive(tab.dataset.slug);
    });
  });

  if ('IntersectionObserver' in window && sections.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const slug = (entry.target as HTMLElement).dataset.categorySection;
            if (slug) setActive(slug);
          }
        });
      },
      { rootMargin: '-45% 0px -50% 0px', threshold: 0 }
    );
    sections.forEach((section) => observer.observe(section));
  }
</script>