---
interface Props {
  categorias: { categoria: string; slug: string; firstPageIndex: number }[];
}

const { categorias } = Astro.props;
---

<nav
  id="category-nav"
  class="sticky top-0 z-30 bg-paper/95 backdrop-blur-sm border-b border-line"
  aria-label="Categorías del menú"
>
  <div class="no-scrollbar flex gap-2 overflow-x-auto px-4 py-3 snap-x snap-mandatory justify-center w-full">
    {categorias.map(({ categoria, slug, firstPageIndex }, i) => (
      <a
        href={`#cat-${slug}`}
        data-slug={slug}
        data-first-page-index={firstPageIndex}
        class:list={[
          'nav-tab snap-start shrink-0 whitespace-nowrap rounded-full px-4 py-1.5 text-base font-medium border transition-colors',
          i === 0
            ? 'is-active bg-accent text-paper border-accent'
            : 'bg-transparent text-ink border-line',
        ]}
      >
        {categoria}
      </a>
    ))}
  </div>
</nav>

<!--
  Nota: este componente ya NO controla el estado activo por sí mismo
  (antes usaba scroll + IntersectionObserver). Ahora es "tonto":
  solo renderiza los botones. El controlador del libro (en index.astro)
  escucha los clicks y decide a qué página saltar, además de encargarse
  de resaltar la pestaña activa.
-->